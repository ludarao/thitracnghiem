# ===========================================================
# VERCEL POSTGRES (Prisma Integration)
# ===========================================================
# Sau khi kết nối Vercel Postgres trong dashboard Vercel,
# vào Project Settings -> Environment Variables để lấy các giá trị này.
# Hoặc chạy: vercel env pull .env.local
#
# Tên biến sẽ tùy thuộc vào Custom Prefix bạn đã đặt khi cài đặt.
# Ví dụ nếu prefix là DATABASE thì sẽ là DATABASE_URL:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# ===========================================================
# ADMIN SECRET KEY — Dùng để xác nhận xóa toàn bộ dữ liệu thi
# Đổi thành chuỗi bí mật phức tạp của bạn
# ===========================================================
ADMIN_SECRET_KEY=quiz_admin_secret_2026
