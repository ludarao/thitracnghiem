# Database PostgreSQL hiện có (Vercel/Neon hoặc nhà cung cấp khác)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# URL trực tiếp cho migration, có thể dùng cùng URL nếu không qua pooler
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Mật khẩu admin ban đầu, ít nhất 10 ký tự; không có mật khẩu mặc định.
# Chỉ dùng để tạo tài khoản lần đầu. Sau đó đổi mật khẩu tại /admin.
ADMIN_PASSWORD=

# Phiên bản 1.1: chỉ bật sau khi tạo widget Turnstile cho hostname của web.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
